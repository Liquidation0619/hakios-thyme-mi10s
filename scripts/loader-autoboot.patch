+/* Fill the screen with one colour (0xAARRGGBB as UEFI's GOP wants it). The loader's only output on
+ * a phone with no serial port; the iOS boot path paints a colour per step with it. */
+static void
+ios_colour(uint32_t bgra)
+{
+	if (SCREEN.base == 0 || SCREEN.stride == 0) {
+		return;
+	}
+	volatile uint32_t *row = (volatile uint32_t *)(uintptr_t)SCREEN.base;
+	uint32_t words = SCREEN.stride / 4;
+
+	for (uint32_t y = 0; y < SCREEN.height; y++) {
+		volatile uint32_t *p = row + (uint64_t)y * words;
+		for (uint32_t x = 0; x < SCREEN.width; x++) {
+			p[x] = bgra;
+		}
+	}
+}
+
+/* A GPT partition's block I/O, by name (UTF-16, as the partition table has it). */
+static efi_block_io *
+find_partition_bio(const char16 *want)
+{
+	static const efi_guid part_guid = EFI_PARTITION_INFO_GUID;
+	static const efi_guid blk_guid = EFI_BLOCK_IO_GUID;
+	efi_handle *handles;
+	uint64_t count;
+
+	if (EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &part_guid, NULL, &count, &handles))) {
+		return NULL;
+	}
+	for (uint64_t i = 0; i < count; i++) {
+		efi_partition_info *info;
+		efi_block_io *bio;
+		int match = 1;
+
+		if (EFI_ERROR(BS->handle_protocol(handles[i], &part_guid, (void **)&info)) || info->type != 2) {
+			continue;
+		}
+		for (unsigned k = 0; want[k] != 0 || info->name[k] != 0; k++) {
+			if (info->name[k] != want[k]) {
+				match = 0;
+				break;
+			}
+		}
+		if (match && !EFI_ERROR(BS->handle_protocol(handles[i], &blk_guid, (void **)&bio))) {
+			return bio;
+		}
+	}
+	return NULL;
+}
+
+/* Read `len` bytes of a partition, from byte offset `at`, in chunks that keep whole blocks. *//* Read bytes of a partition from byte offset `at` into `dest`, in blocks through the loader's own
+ * storage buffer. `at` need not be block-aligned: the leading partial block is read too. */
+static int
+read_partition_bytes(efi_block_io *bio, uint64_t at, uint64_t len, uint8_t *dest)
+{
+	uint64_t bs = bio->media->block_size;
+	uint64_t done = 0;
+
+	if (bio == NULL || bs == 0 || bs > BLOCK_BUFFER_SIZE) {
+		print("ios: bad partition read (%d bytes at %x)\n", len, at);
+		return 0;
+	}
+	if ((at % bs) != 0) {
+		uint64_t head = bs - (at % bs);
+		efi_status st;
+
+		if (head > len) {
+			head = len;
+		}
+		st = bio->read_blocks(bio, bio->media->media_id, at / bs, bs, block_buffer);
+		if (EFI_ERROR(st)) {
+			print("ios: reading the leading block at %x: error %x\n", at, (uint64_t)st);
+			return 0;
+		}
+		memcpy(dest, block_buffer + (at % bs), (size_t)head);
+		done = head;
+	}
+	while (done < len) {
+		uint64_t pos = at + done;
+		uint64_t want = len - done < BLOCK_BUFFER_SIZE ? (len - done + bs - 1) / bs * bs : BLOCK_BUFFER_SIZE;
+		efi_status st = bio->read_blocks(bio, bio->media->media_id, pos / bs, want, block_buffer);
+
+		if (EFI_ERROR(st)) {
+			print("ios: reading (at %x, %d bytes): error %x\n", pos, want, (uint64_t)st);
+			return 0;
+		}
+		memcpy(dest + done, block_buffer, len - done < want ? len - done : want);
+		done += len - done < want ? len - done : want;
+		if (wdt_armed) {
+			wdt_pet();
+		}
+	}
+	return 1;
+}
+
+/*
+ * Boot the iOS installation from its own partition ("ios", carved off the end of userdata):
+ * header at 0, the XNUP payload after it, the system image after that.
+ * Returns only when there is nothing to boot or when the kernel has returned.
+ */
+static void
+ios_storage_try_boot(void)
+{
+	static struct ios_storage_header hdr;
+	struct payload_info pi;
+	efi_block_io *ios = find_partition_bio(u"darwin");
+	uint64_t payload_at = IOS_HEADER_BYTES;
+
+	ios_colour(0xFF000000);                /* black: looking */
+	if (ios == NULL) {
+		print("ios: no installation partition\n");
+		flush_log();
+		return;
+	}
+	if (!read_partition_bytes(ios, 0, IOS_HEADER_BYTES, (uint8_t *)&hdr)) {
+		return;
+	}
+	ios_colour(0xFFFF0000);                /* blue: header read */
+	print("ios: stage header done, magic ok, system %d, payload %d\n", hdr.system_len, hdr.payload_len);
+	flush_log();
+	if (memcmp(hdr.magic, IOS_STORAGE_MAGIC, 8) != 0) {
+		print("ios: no installation (magic %x)\n", (uint64_t)*(const uint64_t *)hdr.magic);
+		return;
+	}
+	print("ios: installation found: version %d, system %d bytes, payload %d\n",
+	    hdr.version, hdr.system_len, hdr.payload_len);
+	if (hdr.boot_mode != 0) {
+		print("ios: boot_mode %d wants the loader instead\n", hdr.boot_mode);
+		return;
+	}
+	if (hdr.payload_len == 0 || hdr.payload_len > PAYLOAD_MAX_SIZE) {
+		print("ios: payload size is not sane\n");
+		return;
+	}
+	if (!read_partition_bytes(ios, payload_at, hdr.payload_len, (uint8_t *)PAYLOAD_BASE)) {
+		return;
+	}
+	ios_colour(0xFF00FF00);                /* green: payload read */
+	if (!parse_payload(&pi, 1) || pi.kernel == NULL) {
+		print("ios: the payload has no kernel\n");
+		return;
+	}
+	pi.resident_rd = hdr.system_len;
+	if (!choose_window(&pi)) {
+		print("ios: no memory window for the kernel\n");
+		return;
+	}
+	ios_colour(0xFF00FFFF);                /* yellow: window chosen */
+	print("ios: stage window done: base %x size %x\n", win_base, win_size);
+	flush_log();
+	if (win_size < RESIDENT_RD_OFFSET + hdr.system_len + RESIDENT_RD_RESERVE) {
+		print("ios: the window (%d) is too small for the system image (%d)\n", win_size, hdr.system_len);
+		return;
+	}
+	uint8_t *dest = (uint8_t *)(win_base + RESIDENT_RD_OFFSET);
+	uint64_t sys_at = payload_at + hdr.payload_len;
+	print("ios: putting the system image at %x (%d bytes from %x)\n",
+	    win_base + RESIDENT_RD_OFFSET, hdr.system_len, sys_at);
+	if (!read_partition_bytes(ios, sys_at, hdr.system_len, dest)) {
+		return;
+	}
+	ios_colour(0xFFFF00FF);                /* magenta: system image read */
+	print("ios: stage system done, NXSB %x\n", (uint64_t)*(const uint32_t *)(dest + 32));
+	flush_log();
+	if (memcmp(dest + 32, "NXSB", 4) != 0) {
+		print("ios: what was read back is not an APFS container (magic %x)\n",
+		    (uint64_t)*(const uint32_t *)(dest + 32));
+		return;
+	}
+	resident_rd_size = hdr.system_len;
+	ios_colour(0xFFFFFFFF);                /* white: running the kernel */
+	print("ios: stage all done, running the kernel from the flash\n");
+	flush_log();
+	print("ios: running the kernel\n");
+	run_kernel(0, 0);
+	/* the run is over (and the data volume saved): reset, so the next boot loads the store back */
+	flush_log();
+	reboot();
+}
