+/* ---- the iOS installation in the phone's own flash ----------------------------------------- */
+
+/* The installation's header sits at the first LBA past every logical partition in `super`: the
+ * phone's lpdump has the extents end at disk LBA 15674416 and super begin at 2048, so the header
+ * is at super-relative LBA 15672368.  (tools/ufs-super.py checks exactly that nothing covers the
+ * range from there to the end of super.) */
+#define IOS_SUPER_LBA       15672368ULL
+#define IOS_STORAGE_MAGIC   "IOSSTOR1"
+#define IOS_HEADER_BYTES    4096ULL
+
+struct ios_storage_header {
+	uint8_t  magic[8];
+	uint32_t version;
+	uint32_t boot_mode;             /* 0: boot iOS; 1: stay in the loader for USB */
+	uint64_t payload_len;           /* the XNUP container that follows the header */
+	uint64_t system_len;            /* the whole system image */
+	uint64_t part1_len;             /* system bytes in region A, after the payload */
+	uint64_t part2_len;             /* system bytes in region B (cust) */
+	uint64_t part3_len;             /* system bytes in region C (exaid) */
+	uint64_t flags;
+	uint8_t  reserved[32];
+	uint8_t  sha256[32];
+};
 #define CHECKPOINT_SELFTEST 999
